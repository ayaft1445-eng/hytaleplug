// Кнопка вкладки «ТАБЛИЦА ЛИДЕРОВ» (невыбранная). Название вкладки меняется в строке Text.

@TabStyle = TextButtonStyle(
  Default: (Background: #2d1b4e, LabelStyle: (FontSize: 15, TextColor: #a78bd8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #3b2566, LabelStyle: (FontSize: 15, TextColor: #a78bd8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #241040, LabelStyle: (FontSize: 15, TextColor: #a78bd8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

TextButton {
  Text: "ТАБЛИЦА ЛИДЕРОВ";
  Anchor: (Width: 186, Height: 48);
  Style: @TabStyle;
}
