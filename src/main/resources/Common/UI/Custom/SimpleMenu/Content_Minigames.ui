// Вкладка «Мини-игры». Режимы тестовые: название, описание и кнопка «Найти группу» (пока заглушка).

@FindStyle = TextButtonStyle(
  Default: (Background: #7c3aed, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #8b5cf6, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #6d28d9, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Full: 0);
  LayoutMode: Top;
  Padding: (Full: 24);

  Label {
    Text: "МИНИ-ИГРЫ";
    Anchor: (Height: 40);
    Style: (FontSize: 26, TextColor: #e9d5ff, HorizontalAlignment: Center, RenderBold: true);
  }
  Group { Anchor: (Height: 2); Background: #6d28d9; }
  Group { Anchor: (Height: 16); }
  Group {
    Anchor: (Height: 100);
    LayoutMode: Left;

    Group {
      Anchor: (Width: 90, Height: 90);
      Background: #241040;
      LayoutMode: Center;

      Label {
        Text: "ИКОНКА";
        Anchor: (Height: 16);
        Style: (FontSize: 11, TextColor: #8b7bb8, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }
    Group { Anchor: (Width: 16); }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label {
        Text: "ЗАХВАТ ФЛАГА";
        Anchor: (Height: 28);
        Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true);
      }
      Group { Anchor: (Height: 6); }
      Label {
        Text: "Две команды. Унеси флаг соперника";
        Anchor: (Height: 22);
        Style: (FontSize: 15, TextColor: #c4b5fd);
      }
      Label {
        Text: "на свою базу раньше врага.";
        Anchor: (Height: 22);
        Style: (FontSize: 15, TextColor: #c4b5fd);
      }
    }

    Group { Anchor: (Width: 16); }

    Group {
      Anchor: (Width: 220);
      LayoutMode: Center;

      TextButton #FindGroup0 {
        Text: "НАЙТИ ГРУППУ";
        Anchor: (Width: 220, Height: 46);
        Style: @FindStyle;
      }
    }
  }
  Group { Anchor: (Height: 14); }
  Group {
    Anchor: (Height: 100);
    LayoutMode: Left;

    Group {
      Anchor: (Width: 90, Height: 90);
      Background: #241040;
      LayoutMode: Center;

      Label {
        Text: "ИКОНКА";
        Anchor: (Height: 16);
        Style: (FontSize: 11, TextColor: #8b7bb8, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }
    Group { Anchor: (Width: 16); }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label {
        Text: "ВЫЖИВАНИЕ";
        Anchor: (Height: 28);
        Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true);
      }
      Group { Anchor: (Height: 6); }
      Label {
        Text: "Держись как можно дольше";
        Anchor: (Height: 22);
        Style: (FontSize: 15, TextColor: #c4b5fd);
      }
      Label {
        Text: "против волн монстров.";
        Anchor: (Height: 22);
        Style: (FontSize: 15, TextColor: #c4b5fd);
      }
    }

    Group { Anchor: (Width: 16); }

    Group {
      Anchor: (Width: 220);
      LayoutMode: Center;

      TextButton #FindGroup1 {
        Text: "НАЙТИ ГРУППУ";
        Anchor: (Width: 220, Height: 46);
        Style: @FindStyle;
      }
    }
  }
  Group { Anchor: (Height: 14); }
  Group {
    Anchor: (Height: 100);
    LayoutMode: Left;

    Group {
      Anchor: (Width: 90, Height: 90);
      Background: #241040;
      LayoutMode: Center;

      Label {
        Text: "ИКОНКА";
        Anchor: (Height: 16);
        Style: (FontSize: 11, TextColor: #8b7bb8, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }
    Group { Anchor: (Width: 16); }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label {
        Text: "ПАРКУР";
        Anchor: (Height: 28);
        Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true);
      }
      Group { Anchor: (Height: 6); }
      Label {
        Text: "Пройди трассу с препятствиями";
        Anchor: (Height: 22);
        Style: (FontSize: 15, TextColor: #c4b5fd);
      }
      Label {
        Text: "на время. Есть рекорд сервера.";
        Anchor: (Height: 22);
        Style: (FontSize: 15, TextColor: #c4b5fd);
      }
    }

    Group { Anchor: (Width: 16); }

    Group {
      Anchor: (Width: 220);
      LayoutMode: Center;

      TextButton #FindGroup2 {
        Text: "НАЙТИ ГРУППУ";
        Anchor: (Width: 220, Height: 46);
        Style: @FindStyle;
      }
    }
  }
}
