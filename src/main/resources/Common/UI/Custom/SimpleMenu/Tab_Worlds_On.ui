// Кнопка вкладки «МИРЫ» (ВЫБРАННАЯ). Название вкладки меняется в строке Text.

@TabStyle = TextButtonStyle(
  Default: (Background: #7c3aed, LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #8b5cf6, LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #6d28d9, LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

TextButton {
  Text: "МИРЫ";
  Anchor: (Width: 186, Height: 48);
  Style: @TabStyle;
}
