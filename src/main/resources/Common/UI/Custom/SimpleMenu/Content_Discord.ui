// Вкладка «Дискорд». Ссылку меняй в строке Text ниже.

Group {
  Anchor: (Full: 0);
  LayoutMode: Top;
  Padding: (Full: 24);

  Label {
    Text: "ДИСКОРД";
    Anchor: (Height: 40);
    Style: (FontSize: 26, TextColor: #e9d5ff, HorizontalAlignment: Center, RenderBold: true);
  }
  Group { Anchor: (Height: 2); Background: #6d28d9; }
  Group { Anchor: (Height: 16); }
  Label {
    Text: "Заходи в наш Discord:";
    Anchor: (Height: 30);
    Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true);
  }
  Group { Anchor: (Height: 14); }
  Label {
    Text: "discord.gg/ЗАМЕНИ-НА-СВОЮ-ССЫЛКУ";
    Anchor: (Height: 30);
    Style: (FontSize: 20, TextColor: #a78bfa, RenderBold: true);
  }
  Group { Anchor: (Height: 14); }
  Label {
    Text: "Скопируй ссылку и открой её в браузере.";
    Anchor: (Height: 22);
    Style: (FontSize: 14, TextColor: #8b7bb8, RenderBold: false);
  }
}
