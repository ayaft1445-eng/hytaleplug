// Главное меню сервера: заголовок, две вкладки и содержимое вкладок.
// Переключение вкладок делает сервер (MainMenuPage.java), меняя свойство Visible у панелей.

@TabActiveStyle = TextButtonStyle(
  Default: (Background: #3a7bd5, LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #4a8be5, LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #2a6bc5, LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@TabIdleStyle = TextButtonStyle(
  Default: (Background: #2b3542, LabelStyle: (FontSize: 15, TextColor: #96a9be, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #3b4552, LabelStyle: (FontSize: 15, TextColor: #b6c9de, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #1b2532, LabelStyle: (FontSize: 15, TextColor: #96a9be, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 560, Height: 380);
  Background: #141c26(0.98);
  LayoutMode: Top;
  Padding: (Full: 20);

  // Заголовок
  Label {
    Text: "ГЛАВНОЕ МЕНЮ";
    Anchor: (Height: 40);
    Style: (FontSize: 24, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
  }

  Group { Anchor: (Height: 1); Background: #2b3542; }
  Group { Anchor: (Height: 14); }

  // Ряд вкладок
  Group {
    Anchor: (Height: 44);
    LayoutMode: Left;

    TextButton #TabMinigames {
      Text: "МИНИ-ИГРЫ";
      Anchor: (Width: 240, Height: 44);
      Style: @TabActiveStyle;
    }

    Group { Anchor: (Width: 12); }

    TextButton #TabLeaderboard {
      Text: "ТАБЛИЦА ЛИДЕРОВ";
      Anchor: (Width: 260, Height: 44);
      Style: @TabIdleStyle;
    }
  }

  Group { Anchor: (Height: 14); }

  // Содержимое вкладок: обе панели лежат друг над другом,
  // видна всегда только одна.
  Group #Content {
    FlexWeight: 1;
    Background: #0d1218(0.5);

    Group #PanelMinigames {
      Anchor: (Full: 0);
      LayoutMode: Center;

      Label {
        Text: "Добро пожаловать";
        Anchor: (Height: 28);
        Style: (FontSize: 20, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }

    Group #PanelLeaderboard {
      Anchor: (Full: 0);
      LayoutMode: Center;
      Visible: false;

      Label {
        Text: "Добро пожаловать";
        Anchor: (Height: 28);
        Style: (FontSize: 20, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }
  }

  Group { Anchor: (Height: 14); }

  // Кнопка закрытия
  Group {
    Anchor: (Height: 44);
    LayoutMode: Center;

    TextButton #CloseButton {
      Text: "ЗАКРЫТЬ";
      Anchor: (Width: 160, Height: 44);
      Style: @TabIdleStyle;
    }
  }

  Group { Anchor: (Height: 6); }

  Label {
    Text: "ESC — закрыть меню";
    Anchor: (Height: 16);
    Style: (FontSize: 11, TextColor: #6e7da1, HorizontalAlignment: Center);
  }
}
