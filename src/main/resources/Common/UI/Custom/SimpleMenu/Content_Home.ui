// Вкладка «Новости» — она же главная. Текст новостей меняется в строках Text ниже.

Group {
  Anchor: (Full: 0);
  LayoutMode: Top;
  Padding: (Full: 24);

  Label {
    Text: "НОВОСТИ";
    Anchor: (Height: 40);
    Style: (FontSize: 26, TextColor: #e9d5ff, HorizontalAlignment: Center, RenderBold: true);
  }
  Group { Anchor: (Height: 2); Background: #6d28d9; }
  Group { Anchor: (Height: 16); }
  Group {
    Anchor: (Height: 90);
    LayoutMode: Left;

    Group {
      Anchor: (Width: 90, Height: 90);
      Background: #241040;
      LayoutMode: Center;

      Label {
        Text: "ИКОНКА";
        Anchor: (Height: 16);
        Style: (FontSize: 11, TextColor: #8b7bb8, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }
    Group { Anchor: (Width: 16); }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label {
        Text: "ОТКРЫТИЕ СЕРВЕРА";
        Anchor: (Height: 28);
        Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true);
      }
      Group { Anchor: (Height: 6); }
      Label {
        Text: "Мы запустились! Заходите, зовите друзей";
        Anchor: (Height: 22);
        Style: (FontSize: 15, TextColor: #c4b5fd, RenderBold: false);
      }
      Label {
        Text: "и пишите о багах в Discord.";
        Anchor: (Height: 22);
        Style: (FontSize: 15, TextColor: #c4b5fd, RenderBold: false);
      }
    }
  }
  Group { Anchor: (Height: 16); }
  Group {
    Anchor: (Height: 90);
    LayoutMode: Left;

    Group {
      Anchor: (Width: 90, Height: 90);
      Background: #241040;
      LayoutMode: Center;

      Label {
        Text: "ИКОНКА";
        Anchor: (Height: 16);
        Style: (FontSize: 11, TextColor: #8b7bb8, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }
    Group { Anchor: (Width: 16); }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label {
        Text: "НОВАЯ МИНИ-ИГРА";
        Anchor: (Height: 28);
        Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true);
      }
      Group { Anchor: (Height: 6); }
      Label {
        Text: "Скоро добавим «Захват флага»:";
        Anchor: (Height: 22);
        Style: (FontSize: 15, TextColor: #c4b5fd, RenderBold: false);
      }
      Label {
        Text: "две команды, один флаг, много шума.";
        Anchor: (Height: 22);
        Style: (FontSize: 15, TextColor: #c4b5fd, RenderBold: false);
      }
    }
  }
  Group { Anchor: (Height: 16); }
  Group {
    Anchor: (Height: 90);
    LayoutMode: Left;

    Group {
      Anchor: (Width: 90, Height: 90);
      Background: #241040;
      LayoutMode: Center;

      Label {
        Text: "ИКОНКА";
        Anchor: (Height: 16);
        Style: (FontSize: 11, TextColor: #8b7bb8, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }
    Group { Anchor: (Width: 16); }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label {
        Text: "ОБНОВЛЕНИЕ МИРА";
        Anchor: (Height: 28);
        Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true);
      }
      Group { Anchor: (Height: 6); }
      Label {
        Text: "Спавн перестроен, добавлены порталы";
        Anchor: (Height: 22);
        Style: (FontSize: 15, TextColor: #c4b5fd, RenderBold: false);
      }
      Label {
        Text: "к аренам и торговой площади.";
        Anchor: (Height: 22);
        Style: (FontSize: 15, TextColor: #c4b5fd, RenderBold: false);
      }
    }
  }
}
