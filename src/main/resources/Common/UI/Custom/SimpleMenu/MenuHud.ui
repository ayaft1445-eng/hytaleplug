// Плашка в правом нижнем углу экрана. Видна постоянно, поверх игры.
// Размер и отступы от края меняются в Anchor у группы #MenuBadge.

Group {
  Anchor: (Full: 0);

  Group #MenuBadge {
    Anchor: (Width: 190, Height: 50, Right: 24, Bottom: 24);
    Background: #1a0f2e(0.9);
    LayoutMode: Center;

    Label {
      Text: "МЕНЮ — /menu";
      Anchor: (Height: 20);
      Style: (FontSize: 15, TextColor: #e9d5ff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
    }
  }
}
