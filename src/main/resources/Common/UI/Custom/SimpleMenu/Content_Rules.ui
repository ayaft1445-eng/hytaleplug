// Вкладка «Правила». Текст правил меняется в строках Text ниже.

Group {
  Anchor: (Full: 0);
  LayoutMode: Top;
  Padding: (Full: 24);

  Label {
    Text: "ПРАВИЛА";
    Anchor: (Height: 40);
    Style: (FontSize: 26, TextColor: #e9d5ff, HorizontalAlignment: Center, RenderBold: true);
  }
  Group { Anchor: (Height: 2); Background: #6d28d9; }
  Group { Anchor: (Height: 16); }
  Label {
    Text: "1. Уважай других игроков: без оскорблений и токсичности.";
    Anchor: (Height: 26);
    Style: (FontSize: 16, TextColor: #ffffff);
  }
  Group { Anchor: (Height: 8); }
  Label {
    Text: "2. Читы, багоюз и сторонние программы запрещены.";
    Anchor: (Height: 26);
    Style: (FontSize: 16, TextColor: #ffffff);
  }
  Group { Anchor: (Height: 8); }
  Label {
    Text: "3. Не ломай и не забирай чужие постройки и вещи.";
    Anchor: (Height: 26);
    Style: (FontSize: 16, TextColor: #ffffff);
  }
  Group { Anchor: (Height: 8); }
  Label {
    Text: "4. Реклама других серверов запрещена.";
    Anchor: (Height: 26);
    Style: (FontSize: 16, TextColor: #ffffff);
  }
  Group { Anchor: (Height: 8); }
  Label {
    Text: "5. Решение администрации окончательное.";
    Anchor: (Height: 26);
    Style: (FontSize: 16, TextColor: #ffffff);
  }
  Group { Anchor: (Height: 18); }
  Label {
    Text: "Это текст-заглушка — замени на свои правила.";
    Anchor: (Height: 20);
    Style: (FontSize: 13, TextColor: #8b7bb8);
  }
}
