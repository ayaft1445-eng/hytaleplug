// Кнопка НЕ выбранной вкладки — тёмная. Текст подставляет сервер.

@IdleTabStyle = TextButtonStyle(
  Default: (Background: #2d1b4e, LabelStyle: (FontSize: 17, TextColor: #a78bd8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #3b2566, LabelStyle: (FontSize: 17, TextColor: #e9d5ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #241040, LabelStyle: (FontSize: 17, TextColor: #a78bd8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

TextButton {
  Text: "ВКЛАДКА";
  Anchor: (Width: 228, Height: 50);
  Style: @IdleTabStyle;
}
