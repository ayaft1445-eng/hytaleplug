// Вкладка «Косметика».

Group {
  Anchor: (Full: 0);
  LayoutMode: Top;
  Padding: (Full: 24);

  Label {
    Text: "КОСМЕТИКА";
    Anchor: (Height: 40);
    Style: (FontSize: 26, TextColor: #e9d5ff, HorizontalAlignment: Center, RenderBold: true);
  }
  Group { Anchor: (Height: 2); Background: #6d28d9; }
  Group { Anchor: (Height: 16); }
  Label {
    Text: "Скины, питомцы и эмоции.";
    Anchor: (Height: 30);
    Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true);
  }
  Group { Anchor: (Height: 12); }
  Label {
    Text: "В процессе создания.";
    Anchor: (Height: 24);
    Style: (FontSize: 16, TextColor: #c4b5fd, RenderBold: false);
  }
}
