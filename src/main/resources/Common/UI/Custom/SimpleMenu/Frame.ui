// Рамка меню: заголовок, полоса вкладок сверху (#TabBar), четыре пустых слота слева
// (запас на будущие вкладки) и область содержимого (#Content).
// Кнопки вкладок и содержимое вставляет сервер — см. MainMenuPage.java.
// Размер окна меняется в Anchor у самой первой группы.

@NewsStyle = TextButtonStyle(
  Default: (Background: #7c3aed, LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #8b5cf6, LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #6d28d9, LabelStyle: (FontSize: 16, TextColor: #c4b5fd, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@CloseStyle = TextButtonStyle(
  Default: (Background: #2d1b4e, LabelStyle: (FontSize: 16, TextColor: #c4b5fd, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #3b2566, LabelStyle: (FontSize: 16, TextColor: #c4b5fd, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #241040, LabelStyle: (FontSize: 16, TextColor: #e9d5ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 1160, Height: 720);
  Background: #1a0f2e(0.98);
  LayoutMode: Top;
  Padding: (Full: 20);

  Label {
    Text: "МЕНЮ СЕРВЕРА";
    Anchor: (Height: 56);
    Style: (FontSize: 32, TextColor: #e9d5ff, HorizontalAlignment: Center, RenderBold: true);
  }

  Group { Anchor: (Height: 2); Background: #6d28d9; }
  Group { Anchor: (Height: 14); }

  // Сюда сервер вставляет шесть кнопок вкладок
  Group #TabBar {
    Anchor: (Height: 48);
    LayoutMode: Left;
  }

  Group { Anchor: (Height: 14); }

  Group {
    FlexWeight: 1;
    LayoutMode: Left;

    // Четыре пустых слота слева — запас под будущие вкладки
    Group {
      Anchor: (Width: 130);
      LayoutMode: Top;

      Group { Anchor: (Height: 100); Background: #241040; }
      Group { Anchor: (Height: 12); }
      Group { Anchor: (Height: 100); Background: #241040; }
      Group { Anchor: (Height: 12); }
      Group { Anchor: (Height: 100); Background: #241040; }
      Group { Anchor: (Height: 12); }
      Group { Anchor: (Height: 100); Background: #241040; }
    }

    Group { Anchor: (Width: 14); }

    // Сюда сервер вставляет содержимое выбранной вкладки
    Group #Content {
      FlexWeight: 1;
      Background: #150b26(0.9);
    }
  }

  Group { Anchor: (Height: 14); }

  Group {
    Anchor: (Height: 46);
    LayoutMode: Center;

    TextButton #NewsButton {
      Text: "НОВОСТИ";
      Anchor: (Width: 220, Height: 46);
      Style: @NewsStyle;
    }

    Group { Anchor: (Width: 16); }

    TextButton #CloseButton {
      Text: "ЗАКРЫТЬ";
      Anchor: (Width: 220, Height: 46);
      Style: @CloseStyle;
    }
  }

  Group { Anchor: (Height: 8); }

  Label {
    Text: "ESC — закрыть меню";
    Anchor: (Height: 18);
    Style: (FontSize: 13, TextColor: #6b5a94, HorizontalAlignment: Center);
  }
}
